# ---------------------------------------------------------------------------
# Adzuna API credentials
# Register (free) at https://developer.adzuna.com to get an app_id and app_key.
# Copy this file to `.env` and fill in your real values.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ---------------------------------------------------------------------------
# Extraction window
# ---------------------------------------------------------------------------
# Only ads created on/after this date are kept in the cleaned layer.
# NOTE: the search API only exposes live ads (~45 days), so this is the window
# used going forward (plus history aggregates for trends).
ADZUNA_START_DATE=2026-01-01

# Comma-separated country codes. NOTE: 'us' may not be on the Adzuna API's
# documented market list; fall back to a supported code (e.g. ca) if rejected.
ADZUNA_COUNTRIES=gb,us

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ADZUNA_DATA_DIR=data
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES_PER_COUNTRY=100
ADZUNA_RATE_LIMIT_SLEEP_SECONDS=1.0
ADZUNA_MAX_DAYS_OLD=45

# ---------------------------------------------------------------------------
# DuckDB warehouse (phase 1)
# ---------------------------------------------------------------------------
# When set, cleaned + analysis data is upserted into this DuckDB file.
ADZUNA_DB_PATH=data/adzuna.duckdb

# ---------------------------------------------------------------------------
# Google Sheets export (Looker Studio data source)
# ---------------------------------------------------------------------------
ADZUNA_EXPORT_TO_SHEETS=false
# Absolute path to a Google service-account JSON (never commit this file).
ADZUNA_GOOGLE_SHEETS_CREDENTIALS=/absolute/path/to/sa_credentials.json
# The spreadsheet id (long id in the spreadsheet URL).
ADZUNA_GOOGLE_SHEETS_KEY=your-spreadsheet-id
# Print the export instead of calling the Sheets API.
ADZUNA_SHEETS_DRY_RUN=true

# ---------------------------------------------------------------------------
# Development helpers
# ---------------------------------------------------------------------------
ADZUNA_MOCK_MODE=false
ADZUNA_MOCK_ROWS=2500
ADZUNA_FAIL_ON_VALIDATION=false
