# ---------------------------------------------------------------------------
# Adzuna API credentials
# Register (free) at https://developer.adzuna.com to get an app_id and app_key.
# Copy this file to `.env` and fill in your real values.
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# ---------------------------------------------------------------------------
# Extraction window
# ---------------------------------------------------------------------------
# Only ads created on/after this date are kept in the cleaned layer.
# NOTE: the Adzuna search API only exposes *live* ads (~45 days), so a single
# backfill cannot recover listings older than that. This sets the window used
# by the pipeline (and the history-based trend backfill).
ADZUNA_START_DATE=2026-01-01

# Comma-separated ISO country codes the API supports, e.g. gb,at,de,fr,nl
ADZUNA_COUNTRIES=gb

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Directory (relative to where you run the pipeline) for raw/ and processed/.
ADZUNA_DATA_DIR=data

# Pagination / politeness
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES_PER_COUNTRY=100
ADZUNA_RATE_LIMIT_SLEEP_SECONDS=1.0
ADZUNA_MAX_DAYS_OLD=45

# ---------------------------------------------------------------------------
# Development helpers
# ---------------------------------------------------------------------------
# Set to true to run against a local mock of the API (no credentials needed).
ADZUNA_MOCK_MODE=false
ADZUNA_MOCK_ROWS=2500

# Stop the pipeline with a non-zero exit code when validation fails.
ADZUNA_FAIL_ON_VALIDATION=false